APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_USER=meeting_dev
POSTGRES_DB=meeting_assistant
POSTGRES_PASSWORD=replace_with_local_random_password
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://meeting_dev:replace_with_local_random_password@127.0.0.1:55432/meeting_assistant

# Generate a random value of at least 32 characters locally.
JWT_SECRET=

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Current Chat Completions models; use max_tokens only for legacy compatible providers.
LLM_TOKEN_LIMIT_PARAMETER=max_completion_tokens
LLM_MAX_COMPLETION_TOKENS=4096
# LLM_TEMPERATURE=0
